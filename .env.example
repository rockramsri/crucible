# Crucible local environment
# Copy to .env and fill in the key that matches ADAPTIVE_MODEL.
# Existing process env vars win over this file.

# Adaptive-layer model as a full pydantic-ai string. Examples:
#   openai:gpt-4.1        anthropic:claude-...      google:gemini-3.6-flash
ADAPTIVE_MODEL=openai:gpt-4.1

# Provider keys (paste the one that matches ADAPTIVE_MODEL).
# Empty values are ignored — crucible-api then runs deterministic-only
# (unresolved SQLi stays INCONCLUSIVE). The API process must see these
# vars: ./scripts/serve_api.sh loads this file at startup.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GEMINI_API_KEY enables Gemini. Current Gemini models refuse to generate
# SQLi payloads even for authorized testing, so the adaptive layer uses
# OpenAI by default. Keep whichever keys you have.
GEMINI_API_KEY=

# Legacy Gemini model knob (only used when ADAPTIVE_MODEL starts with google:).
GEMINI_MODEL=gemini-3.6-flash
