# Point the Crucible UI at a live backend (the FastAPI `crucible-api`).
# Copy to `.env` for local dev.
#
#   - Set it  -> "LIVE API MODE": the UI POSTs the report to the backend and
#                streams Server-Sent Events from it. If the backend is down it
#                gracefully falls back to an in-browser replay.
#   - Leave it unset/blank -> "MOCK MODE": the bundled sample replays entirely
#                in the browser (no backend needed — great for the hosted demo).
VITE_API_BASE=http://localhost:8000
